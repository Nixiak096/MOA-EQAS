# ============ 关系数据库（MySQL，存储供热运营数据）============
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=heating_ops
DB_CHARSET=utf8mb4

# ============ 向量数据库（Milvus，存储规范与计算说明等文本知识）============
# 变量名必须是 MILVUS_DB_URI：pymilvus 自身会读 MILVUS_URI（要求 http(s)://），
# 用本地 Lite 路径会使其导入阶段报错。
# 开发环境用 Milvus Lite（本地文件，无需 Docker）：
MILVUS_DB_URI=milvus_data/heating_knowledge.db
# 部署环境改指向 Milvus 服务端：
# MILVUS_DB_URI=http://milvus-standalone:19530
MILVUS_COLLECTION=heating_knowledge
# 相似度度量：IP（内积，向量已归一化）/ L2 / COSINE
MILVUS_METRIC=IP
# 连接/请求超时（秒）：避免网络或鉴权异常时无限等待
MILVUS_TIMEOUT=10

# ============ 大语言模型 ============
# LLM_PROVIDER 取值：openai（OpenAI 兼容接口）| ollama（本地 Ollama）
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
# ollama 分支
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# —— 按角色指定模型（可选，留空即回退上面的 LLM_MODEL）——
# 只覆盖「模型名」：provider / base_url / 密钥 / 温度 / 超时仍走全局统一值。
# 因此这里填的模型必须由同一个 base_url 提供（例如 AutoDL 上你已开通的那些模型）。
# 角色：检索员（意图补全）、分析师（结果文字解读）、撰稿人（综述与知识类答复）、审核员（定性审查）。
# 典型搭配：审核员用更强的模型把质量关，撰稿人用便宜的模型写文字。
LLM_MODEL_RETRIEVER=
LLM_MODEL_ANALYST=
LLM_MODEL_WRITER=
LLM_MODEL_REVIEWER=

# 问答链路是否调用大模型。
# false：四智能体仍完整协作、全部确定性校验照跑，只是不调模型（离线、快、结果可复现，适合演示与自测）。
AGENT_USE_LLM=true

# ============ 文本向量化 ============
# EMBEDDING_PROVIDER 取值：openai（OpenAI 兼容接口）| ollama（本地 Ollama）| local（本地 transformers 模型）
#
# —— local：用本机已下载的模型，完全离线、无需密钥（推荐开发环境）——
# EMBEDDING_LOCAL_PATH 指向含 config.json / tokenizer 的模型目录；
# bert-base-chinese 的 EMBEDDING_DIM 必须设为 768，bge-m3 为 1024，以此类推。
EMBEDDING_PROVIDER=local
EMBEDDING_LOCAL_PATH=D:/HuanJing/huggingface_model/bert-base-chinese
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIM=768

# —— 仅 Docker 部署需要：把本机模型目录挂进容器 ——
# docker-compose 用它作为挂载源（容器内固定挂到 /models/bert-base-chinese）。
# 留空则回退到 ./models/bert-base-chinese —— 该目录默认为空，会导致 init-data 失败。
# Windows + Docker Desktop：可写 D:/HuanJing/huggingface_model/bert-base-chinese
# WSL 里直接跑 docker：用 /mnt/d/HuanJing/huggingface_model/bert-base-chinese
EMBEDDING_LOCAL_DIR=

# ---- 容器出网代理（可选）----
# 若本机需要代理才能访问外网（pip 源、大模型接口），在此指定。
# 注意 NO_PROXY 必须包含内部服务名，否则容器之间（应用→Milvus/MySQL）的调用会被绕进代理而失败。
# 例：Docker Desktop 的默认内置代理不可用时，可改指向宿主代理，如 http://host.docker.internal:7897
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,mysql,milvus-standalone,etcd,minio,agent-app,nginx-proxy

# —— openai：改用 API 向量模型时启用以下三项 ——
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# text-embedding-3-small 对应 1536 维
# EMBEDDING_DIM=1536

# —— ollama ——
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ============ 供热业务参数（依据《数据及计算说明》）============
# 日耗评价值 = 指标值 × 该系数
EVALUATION_FACTOR=121
# 度日数折标：折标后日耗量 = 日耗量 × (基准温度 + 室内补偿) / (基准温度 − 当天室外平均温度)
DEGREE_DAY_BASE_TEMP=18
DEGREE_DAY_INDOOR_OFFSET=0.7
# 法定正式供热日期（法定已供暖天数基准）
LEGAL_HEATING_START_MONTH=11
LEGAL_HEATING_START_DAY=15
# 标准采暖季累计耗量基准日（11 月 14 日）
DEGREE_DAY_BASELINE_MONTH=11
DEGREE_DAY_BASELINE_DAY=14
# 当前采暖季标签
HEATING_SEASON=2023-2024
# 供热开始日期（设定口，用于「已供暖天数」= 计算日 − 供热开始日期；留空则该口径不可用）
# 格式 YYYY-MM-DD
HEATING_START_DATE=
# 公司级度日数折标所用气象站（HEAPO 站点为匿名化编号，仅作演示/替代温度源；留空则折标不可用）
# 可选值见 dim_weather_station 表，例如：8jB
DEGREE_DAY_STATION=

# ---- 异常检测与工况分析阈值 ----
# 统计越限：超出「均值 ± k × 标准差」判为异常
ANOMALY_SIGMA=2.0
# 突变检测：相邻时点变化率超过该百分比判为突变（能耗类）
ANOMALY_JUMP_PCT=30.0
# 气温突变阈值（℃）：气温日间波动大，用绝对变化而非百分比
ANOMALY_TEMP_JUMP_C=6.0
# 度日数归一化的最小分母（℃·日）：HDD 过小时比值会被放大成假异常
HDD_MIN_FOR_NORMALIZATION=5.0
# 换热站二次侧供回水温差合理区间（℃）
SCADA_DELTA_T_MIN=3.0
SCADA_DELTA_T_MAX=25.0

# ============ 服务 ============
AGENT_APP_HOST=0.0.0.0
AGENT_APP_PORT=5000
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE=50MB
DOCUMENTS_DIR=documents
LOG_LEVEL=INFO
