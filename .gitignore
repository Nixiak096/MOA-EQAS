# ============ 密钥与本机配置（绝不入库）============
# .env 含真实的数据库口令与大模型 API Key
.env
.env.local

# ============ 数据资产（约 5GB，不入仓库）============
# 见 README 第六节：四套数据集（业务运营 / 热泵住户 / 换热站 SCADA / 气象）
# 与 05_standards 下的规范摘要。仓库只含代码与文档，数据需另行准备。
documents/

# 本地向量模型（部署时通过 volume 挂载，约 400MB）
models/

# 本地向量库文件（Milvus Lite 独占锁文件，由 --ingest 重建）
milvus_data/

# 上传文档的暂存区
uploads/

# ============ Python 产物 ============
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ============ IDE / 系统 ============
.idea/
.vscode/
.DS_Store
Thumbs.db

# ============ 个人材料（含姓名/学号，不上传公开仓库）============
# 任务书对照核查.md 含姓名与学号，只留本地
任务书对照核查.md
